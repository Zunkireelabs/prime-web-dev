# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-04-01

# Sanity write token (for migration scripts only — never expose in frontend)
SANITY_API_TOKEN=your-write-token

# EdgeX CRM (lead capture) — form-scoped key, ships in client bundle
NEXT_PUBLIC_CRM_ENDPOINT=https://lead-crm.zunkireelabs.com/api/public/submit/<org>/<form-slug>
NEXT_PUBLIC_CRM_API_KEY=crm_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
